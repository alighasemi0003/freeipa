# FreeIPA local development defaults
# Copied to .env automatically by up.sh if missing.

FREEIPA_VERSION=4.13.4
FEDORA_VERSION=43
# Docker Hub works more reliably than registry.fedoraproject.org under Docker Desktop/WSL.
FEDORA_BASE_IMAGE=fedora

BUILDER_IMAGE=local/freeipa-builder:4.13.4-dev
RUNTIME_IMAGE=local/freeipa-server:4.13.4-dev
CONTAINER_NAME=freeipa-dev
COMPOSE_PROJECT_NAME=freeipa-dev
VOLUME_NAME=freeipa-data

# FQDN = hostname under domain (not the same as the domain itself)
IPA_HOSTNAME=ipa.ipa.test
IPA_DOMAIN=ipa.test
IPA_REALM=IPA.TEST

# Development credentials (not stored in Dockerfiles)
IPA_ADMIN_PASSWORD=Secret123
IPA_DM_PASSWORD=Secret123

# no-update avoids nsupdate when integrated DNS is off (recommended default for WSL).
IPA_SERVER_IP=no-update

# Integrated FreeIPA DNS (BIND) — keep false for simple WSL development.
# When true, scripts load docker-compose.dns.yml and add --setup-dns.
IPA_ENABLE_DNS=false

# Extra ipa-server-install options (appended by official container init-data)
IPA_SERVER_INSTALL_OPTS=

# Published host ports (DNS/53 only when IPA_ENABLE_DNS=true)
HTTP_PORT=80
HTTPS_PORT=443
LDAP_PORT=389
LDAPS_PORT=636
KERBEROS_PORT=88
KERBEROS_PORT_UDP=88
KPASSWD_PORT=464
KPASSWD_PORT_UDP=464
DNS_PORT=53

FREEIPA_CONTAINER_REPO=https://github.com/freeipa/freeipa-container.git
FREEIPA_CONTAINER_REF=master
FREEIPA_CONTAINER_DOCKERFILE=Dockerfile.fedora-43

# Passed to rpmbuild via makerpms/RPMBUILD_OPTS (keep quoted)
RPM_BUILD_OPTS="--without ipatests"

# Embedded in RPM Release via --define=dist=... (local provenance marker)
LOCAL_DIST_TAG=.fc43.ipa4134dev

# Seconds to wait for FreeIPA after start
UP_HEALTH_TIMEOUT=900
